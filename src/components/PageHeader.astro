---
interface Props {
  eyebrow?: string
  title: string
  description?: string
}

const { eyebrow, title, description } = Astro.props
---

<header class="page-header">
  <div>
    {eyebrow && <p class="page-eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    {description && <p class="page-description">{description}</p>}
  </div>
  <slot />
</header>

<style>
  .page-header { display: flex; align-items: flex-end; justify-content: space-between; gap: 32px; margin-bottom: 32px; border-bottom: 1px solid var(--line); padding: 14px 0 28px; }
  .page-eyebrow { margin: 0 0 10px; color: var(--gold-strong); font-family: var(--font-display); font-size: 11px; font-weight: 700; letter-spacing: .14em; }
  h1 { margin: 0; font-size: clamp(30px, 4vw, 44px); font-weight: 750; letter-spacing: -.04em; line-height: 1.2; }
  .page-description { max-width: 760px; margin: 14px 0 0; color: var(--text-secondary); font-size: 15px; line-height: 1.8; }
  @media (max-width: 640px) {
    .page-header { margin-bottom: 24px; padding-top: 4px; padding-bottom: 22px; }
    h1 { font-size: 30px; }
    .page-description { font-size: 14px; }
  }
</style>

---
import { pokedex, number } from '../utils/data'
import type { Pokemon } from '../utils/data'
import TypeBadge from './TypeBadge.astro'

function baseStatTotal(entry: Pokemon) {
  return Object.values(entry.stats).reduce((total, stat) => total + stat, 0)
}

function statTier(total: number) {
  if (total >= 500) return 'high'
  if (total >= 400) return 'medium'
  return 'low'
}

const typeOrder = ['normal', 'fire', 'water', 'grass', 'electric', 'ice', 'fighting', 'poison', 'ground', 'flying', 'psychic', 'bug', 'rock', 'ghost', 'dragon', 'dark', 'steel']
const types = [...new Map(pokedex.pokemon.flatMap((entry) => entry.types).map((type) => [type.slug, type.name])).entries()]
  .map(([slug, name]) => ({ slug, name }))
  .sort((a, b) => typeOrder.indexOf(a.slug) - typeOrder.indexOf(b.slug))
---

<section class="pokedex-browser" aria-label="宝可梦图鉴查询">
  <div class="filters">
    <label class="search-field">
      <span>名称或编号</span>
      <div class="input-with-icon">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="11" cy="11" r="6.5" stroke="currentColor" stroke-width="1.8" /><path d="m16 16 4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
        <input id="pokedex-query" type="search" placeholder="例如：妙蛙种子、025、Pikachu" autocomplete="off" />
      </div>
    </label>
    <label class="type-field">
      <span>属性</span>
      <select id="pokedex-type">
        <option value="">全部属性</option>
        {types.map((type) => <option value={type.slug}>{type.name}</option>)}
      </select>
    </label>
    <button class="reset-button" type="button" disabled>重置</button>
  </div>

  <div class="results-meta">
    <p class="result-count" aria-live="polite">找到 <strong>{pokedex.count}</strong> 只宝可梦</p>
    <span>点击卡片查看完整资料</span>
  </div>

  <div class="pokemon-grid">
    {pokedex.pokemon.map((entry) => (
      <a
        class="pokemon-card"
        href={`/data/pokedex/${number(entry.id)}`}
        data-pokemon-card
        data-types={entry.types.map((type) => type.slug).join(' ')}
        data-search={`${entry.id} ${number(entry.id)} ${entry.slug} ${Object.values(entry.names).join(' ')}`.toLowerCase()}
      >
        <span class="card-number">#{number(entry.id)}</span>
        <span class:list={['card-stats', `stat-${statTier(baseStatTotal(entry))}`]}>{baseStatTotal(entry)}</span>
        <span class="sprite-wrap">
          <img src={`/images/pokemon/${number(entry.id)}.webp`} alt={entry.names.zh} width="96" height="96" loading={entry.id <= 24 ? 'eager' : 'lazy'} decoding="async" />
        </span>
        <strong>{entry.names.zh}</strong>
        <span class="english-name">{entry.names.en}</span>
        <span class="card-types">
          {entry.types.map((type) => <TypeBadge slug={type.slug} name={type.name} />)}
        </span>
      </a>
    ))}
  </div>
  <p class="empty-result" hidden>没有符合条件的宝可梦，请调整搜索内容。</p>
</section>

<script>
  const query = document.querySelector<HTMLInputElement>('#pokedex-query')
  const type = document.querySelector<HTMLSelectElement>('#pokedex-type')
  const reset = document.querySelector<HTMLButtonElement>('.pokedex-browser .reset-button')
  const cards = [...document.querySelectorAll<HTMLElement>('[data-pokemon-card]')]
  const count = document.querySelector<HTMLElement>('.pokedex-browser .result-count strong')
  const empty = document.querySelector<HTMLElement>('.pokedex-browser .empty-result')

  function filterPokemon() {
    const term = query?.value.trim().toLowerCase().replace(/^#/, '') ?? ''
    const selectedType = type?.value ?? ''
    let visible = 0
    cards.forEach((card) => {
      const matchesTerm = !term || card.dataset.search?.includes(term)
      const matchesType = !selectedType || card.dataset.types?.split(' ').includes(selectedType)
      card.hidden = !(matchesTerm && matchesType)
      if (!card.hidden) visible += 1
    })
    if (count) count.textContent = String(visible)
    if (empty) empty.hidden = visible > 0
    if (reset) reset.disabled = !term && !selectedType
  }

  query?.addEventListener('input', filterPokemon)
  type?.addEventListener('change', filterPokemon)
  reset?.addEventListener('click', () => {
    if (query) query.value = ''
    if (type) type.value = ''
    filterPokemon()
    query?.focus()
  })
</script>

<style>
  .filters { display: grid; grid-template-columns: minmax(260px, 1fr) minmax(150px, 210px) auto; gap: 14px; align-items: end; border: 1px solid var(--line); border-radius: 14px; background: var(--surface-raised); padding: 18px; box-shadow: var(--shadow-sm); }
  .filters label { display: grid; gap: 7px; color: var(--text-secondary); font-size: 12px; font-weight: 650; }
  .input-with-icon { position: relative; }
  .input-with-icon svg { position: absolute; top: 50%; left: 13px; width: 17px; height: 17px; color: var(--muted); transform: translateY(-50%); pointer-events: none; }
  input, select { width: 100%; min-height: 44px; border: 1px solid var(--line); border-radius: 9px; outline: 0; background: var(--surface); color: var(--text); padding: 9px 12px; font-size: 14px; }
  input { padding-left: 39px; }
  input:focus, select:focus { border-color: var(--gold); box-shadow: 0 0 0 3px var(--gold-soft); }
  input::placeholder { color: var(--muted); }
  .reset-button { min-height: 44px; border: 1px solid var(--line); border-radius: 9px; background: var(--surface-subtle); padding: 8px 20px; color: var(--text-secondary); font-size: 13px; cursor: pointer; }
  .reset-button:hover:not(:disabled) { border-color: var(--gold); color: var(--gold-strong); }
  .reset-button:disabled { cursor: default; opacity: .4; }
  .results-meta { display: flex; align-items: center; justify-content: space-between; margin: 18px 2px 14px; color: var(--muted); font-size: 12px; }
  .result-count { margin: 0; }
  .result-count strong { color: var(--text); font-variant-numeric: tabular-nums; }
  .pokemon-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(154px, 1fr)); gap: 14px; }
  .pokemon-card { position: relative; display: flex; min-width: 0; overflow: hidden; flex-direction: column; align-items: center; border: 1px solid var(--line); border-radius: 13px; background: var(--surface-raised); padding: 18px 12px 15px; color: var(--text); text-align: center; text-decoration: none; box-shadow: var(--shadow-sm); transition: border-color .2s, box-shadow .2s, transform .2s; }
  .pokemon-card::after { position: absolute; right: -24px; bottom: -30px; width: 80px; height: 80px; border: 1px solid var(--line); border-radius: 50%; content: ''; opacity: .45; }
  .pokemon-card:hover { border-color: var(--gold); box-shadow: 0 8px 24px rgb(54 48 35 / .09); transform: translateY(-3px); }
  .sprite-wrap { display: grid; width: 104px; height: 104px; place-items: center; margin-bottom: 7px; }
  .pokemon-card img { width: 96px; height: 96px; object-fit: contain; image-rendering: pixelated; transition: transform .2s; }
  .pokemon-card:hover img { transform: scale(1.06); }
  .pokemon-card > strong { font-size: 15px; }
  .card-number { position: absolute; top: 10px; left: 12px; z-index: 1; color: var(--muted); font-family: var(--font-display); font-size: 11px; font-variant-numeric: tabular-nums; }
  .card-stats { position: absolute; top: 10px; right: 12px; font-family: var(--font-display); font-size: 13px; font-weight: 700; font-variant-numeric: tabular-nums; }
  .card-stats.stat-high { color: #9256aa; }
  .card-stats.stat-medium { color: #c54f45; }
  .card-stats.stat-low { color: #c77b27; }
  .english-name { overflow: hidden; max-width: 100%; margin-top: 1px; color: var(--muted); font-size: 11px; text-overflow: ellipsis; white-space: nowrap; }
  .card-types { position: relative; z-index: 1; display: flex; justify-content: center; gap: 5px; margin-top: 11px; }
  .empty-result { margin-top: 16px; }
  @media (min-width: 1200px) { .pokemon-grid { grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); } }
  @media (max-width: 640px) {
    .filters { grid-template-columns: 1fr 1fr; gap: 12px; padding: 14px; }
    .search-field { grid-column: 1 / -1; }
    .reset-button { padding-inline: 12px; }
    .results-meta > span { display: none; }
    .pokemon-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
    .pokemon-card { padding-inline: 8px; }
  }
</style>
